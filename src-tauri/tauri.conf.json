{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tetorica Nitro DS Synth",
  "version": "0.100.1",
  "identifier": "net.tetorica.synth-nitro-ds",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run check:release",
    "beforeBuildCommand": "npm run check:release"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Tetorica Nitro DS Synth",
        "width": 1280,
        "height": 900,
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled",
        "create": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Music",
    "resources": {
      "../dist/": "source/"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
